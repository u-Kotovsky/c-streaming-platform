<UserControl x:Class="StreamingPlatform.UIElements.LiveStreamMiniature"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="160" Height="80">
    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFFF0F0"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.25"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource CardBorder}">
        <Border.InputBindings>
            <MouseBinding Gesture="LeftClick"
              Command="{Binding Interact, RelativeSource={RelativeSource AncestorType=UserControl}}"
              CommandParameter="{Binding}"/>
        </Border.InputBindings>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" Foreground="#FF666666"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</UserControl>