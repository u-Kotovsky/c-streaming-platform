<Page x:Class="StreamingPlatform.Views.StreamDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Детали трансляции"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="← Назад" Command="{Binding GoBackCommand}" Width="80"/>
            <TextBlock Text="Детали трансляции" FontSize="22" FontWeight="Bold" Margin="10,0"/>
            <Button Content="✏️ Редактировать" Command="{Binding EditStreamCommand}" Width="160" Margin="10,0"/>
        </StackPanel>

        <!-- Информация о стриме -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12"
                Effect="{StaticResource CardShadow}">
            <StackPanel>
                <TextBlock Text="{Binding Stream.Title}" FontSize="20" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Канал: " FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Stream.Channel.Name}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Статус: " FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Stream.Status}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Начало: " FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Stream.StartDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Длительность: " FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Stream.Duration}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Зрителей: " FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Stream.ViewerCount}"/>
                </StackPanel>
                <Button Content="💰 Отправить донат" Command="{Binding DonateCommand}" 
                        Width="170" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Вкладки: Донаты / Чат -->
        <TabControl Grid.Row="2">
            <TabItem Header="Донаты">
                <DataGrid ItemsSource="{Binding Donations}" AutoGenerateColumns="False"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding User.Username}" Width="120"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="80"/>
                        <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="200"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding DonationDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Чат">
                <DataGrid ItemsSource="{Binding ChatMessages}" AutoGenerateColumns="False"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding User.Username}" Width="120"/>
                        <DataGridTextColumn Header="Сообщение" Binding="{Binding Content}" Width="300"/>
                        <DataGridTextColumn Header="Время" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>