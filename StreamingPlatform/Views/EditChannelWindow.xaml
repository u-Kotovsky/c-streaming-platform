<Window x:Class="StreamingPlatform.Views.EditChannelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать канал" Height="300" Width="400"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Редактирование канала" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
            <TextBlock Text="Название" Margin="0,0,0,2"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
            <TextBlock Text="Описание" Margin="0,0,0,2"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="60"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Отмена" Command="{Binding CancelCommand}" Width="80" Margin="0,0,5,0"/>
                <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="80" Margin="0,0,5,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>