<Page x:Class="StreamingPlatform.Views.DonateHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="История донатов"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="← Назад" Command="{Binding GoBackCommand}" Width="80"/>
            <TextBlock Text="История донатов" FontSize="22" FontWeight="Bold" Margin="10,0"/>
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Donations}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Пользователь" Binding="{Binding User.Username}" Width="120"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="80"/>
                <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="200"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding DonationDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                <DataGridTextColumn Header="Трансляция" Binding="{Binding LiveStream.Title}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>