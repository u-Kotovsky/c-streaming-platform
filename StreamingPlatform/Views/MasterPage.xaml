<Page x:Class="StreamingPlatform.Views.MasterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StreamingPlatform.Views"
      xmlns:control="clr-namespace:StreamingPlatform.UIElements"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MasterPage">

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!-- Have a list of stream channels -->
        <!-- Have a list of live streams -->
        <!-- be able to select channel and do actions with it? -->
        <!--<TextBlock Text="Меню навигации" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4"/>
        <Button Grid.Row="1" Content="История" Command="{Binding ShowHistoryCommand}" Margin="4"/>
        <Button Grid.Row="2" Content="Каталог" Command="{Binding ShowCatalogCommand}" Margin="4"/>
        <Button Grid.Row="3" Content="Подписки" Command="{Binding ShowSubscriptionCommand}" Margin="4"/>-->

        <Grid Grid.Row="0">

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible">
                <ItemsControl ItemsSource="{Binding Path=StreamChannels}" ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel FlowDirection="LeftToRight"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="128" Height="200" Margin="4">
                                <control:StreamChannelMiniature Title="{Binding Path=Title}" Description="{Binding Path=Description}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            
        </Grid>
        <Grid Grid.Row="1">

        </Grid>
    </Grid>
</Page>
