<Window x:Class="StreamingPlatform.Views.SubscribeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление подписки" Height="300" Width="400"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Оформление подписки" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
            <TextBlock Text="Выберите тариф:" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}"
                      DisplayMemberPath="Name" Margin="0,0,0,12"/>
            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock>
                        <Run Text="Стоимость: "/><Run Text="{Binding Price, Mode=OneWay, StringFormat={}{0:C}}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Длительность: "/><Run Text="{Binding DurationDays, Mode=OneWay}"/><Run Text=" дней"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Button Content="Подписаться" Command="{Binding ConfirmCommand}" Height="36"/>
        </StackPanel>
    </Grid>
</Window>